<IfModule mod_rewrite.c>
    RewriteEngine On

    # Prevent direct access to sensitive folders and hidden files
    RewriteRule ^(\.git|\.env|storage/logs|tests|node_modules) - [F,L]

    # Redirect everything to the public directory if extracting directly into public_html root
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
